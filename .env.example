# Naver Cloud Platform Maps client ID
NAVER_MAP_CLIENT_ID=

# API 서버 주소
# - debug: 비워두면 Android emulator 기본값(http://10.0.2.2:8080/)을 사용한다.
# - release: 반드시 지정해야 하며, 비어 있으면 빌드가 실패한다. (https 권장)
BASE_URL=http://10.0.2.2:8080/

# 릴리즈 서명(선택). 비워 두면 서명 없는 release APK가 나온다. 키스토어 파일은 저장소에 넣지 않는다.
RELEASE_STORE_FILE=
RELEASE_STORE_PASSWORD=
RELEASE_KEY_ALIAS=
RELEASE_KEY_PASSWORD=
